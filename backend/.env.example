
# ============================================================
# TripMate AI - Environment Configuration Template
# File: .env.example
# Copy this file to .env and set values for your environment.
# Never commit the real .env file or actual API credentials.
# ============================================================

# ----------------------------
# Application
# ----------------------------
APP_NAME=TripMate AI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
TIMEZONE=Asia/Kolkata

# ----------------------------
# FastAPI Backend
# ----------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ----------------------------
# Streamlit Frontend
# ----------------------------
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8501
FRONTEND_BASE_URL=http://127.0.0.1:8501
API_REQUEST_TIMEOUT_SECONDS=30

# ----------------------------
# Local PostgreSQL Database
# ----------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tripmate_ai
DB_USER=postgres
DB_PASSWORD=Abhi@6261
DB_SSLMODE=disable
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_ECHO_SQL=false

# ----------------------------
# LangGraph Checkpoint Storage
# ----------------------------
# The initial implementation can use PostgreSQL for durable
# graph state and checkpoints after the DB layer is implemented.
CHECKPOINT_BACKEND=postgres

# ----------------------------
# Local Ollama LLM
# ----------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_RETRIES=2

# ----------------------------
# Travel Data Provider Modes
# ----------------------------
# mock = predictable local/test data
# live = configured real provider only
# hybrid = live data where configured, explicit mock fallback
# Never represent mock results as verified live data.
TRAVEL_DATA_MODE=mock
FLIGHT_PROVIDER=mock
HOTEL_PROVIDER=mock
WEATHER_PROVIDER=mock
DESTINATION_PROVIDER=mock
CURRENCY_PROVIDER=mock

# ----------------------------
# Optional Travel Provider Credentials
# ----------------------------
# Leave blank until a provider is configured.
TAVILY_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# ----------------------------
# Request and Workflow Controls
# ----------------------------
MAX_TRIP_DAYS=30
MAX_TRAVELERS=12
MAX_WORKFLOW_RETRIES=2
WORKFLOW_TIMEOUT_SECONDS=300
REQUIRE_APPROVAL_BEFORE_FINALIZATION=true

# ----------------------------
# Security
# ----------------------------
# Replace with a cryptographically random secret before using
# signed tokens or other secret-dependent security features.
APP_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----------------------------
# Logging and Audit
# ----------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
AUDIT_LOG_ENABLED=true

# ----------------------------
# Feature Flags
# ----------------------------
ENABLE_LIVE_TRAVEL_DATA=false
ENABLE_MCP_TOOLS=false
ENABLE_ITINERARY_EXPORT=true
