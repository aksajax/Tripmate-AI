
# ==========================================
# TripMate AI - Git Ignore
# ==========================================

# Environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python compiled files and caches
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Python packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml

# Type checking and linting caches
.mypy_cache/
.pyright/
.ruff_cache/
.dmypy.json
dmypy.json

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Local databases and database backups
*.sqlite
*.sqlite3
*.db
*.dump
*.bak

# Generated exports and reports
exports/
reports/

# Streamlit local configuration and secrets
.streamlit/secrets.toml

# Local model and downloaded artifacts
models/
*.gguf

# Docker local overrides
docker-compose.override.yml

# Environment-specific local configuration
.env.local
.env.development.local
.env.test.local
.env.production.local
