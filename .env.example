# TripMate AI - Environment Configuration Template

# Application
APP_NAME=TripMate AI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
TIMEZONE=Asia/Kolkata

# FastAPI backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Streamlit frontend
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8501
FRONTEND_BASE_URL=http://127.0.0.1:8501
API_REQUEST_TIMEOUT_SECONDS=30

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tripmate_ai
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=disable
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_ECHO_SQL=false

# LangGraph checkpoint storage
CHECKPOINT_BACKEND=postgres

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_RETRIES=2

# Travel data providers
TRAVEL_DATA_MODE=mock
FLIGHT_PROVIDER=mock
HOTEL_PROVIDER=mock
WEATHER_PROVIDER=mock
DESTINATION_PROVIDER=mock
CURRENCY_PROVIDER=mock

# Optional provider credentials
TAVILY_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Trip validation and workflow
MAX_TRIP_DAYS=30
MAX_TRAVELERS=12
MAX_WORKFLOW_RETRIES=2
WORKFLOW_TIMEOUT_SECONDS=300
REQUIRE_APPROVAL_BEFORE_FINALIZATION=true

# Security
APP_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging and auditing
LOG_LEVEL=INFO
LOG_FORMAT=json
AUDIT_LOG_ENABLED=true

# Feature flags
ENABLE_LIVE_TRAVEL_DATA=false
ENABLE_MCP_TOOLS=false
ENABLE_ITINERARY_EXPORT=true